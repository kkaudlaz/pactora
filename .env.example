# Copy this file to .env for local development.
# Never put real secrets in GitHub, even in a private repository.
DATABASE_URL="postgresql://pactora:local-dev-only-change-me@localhost:5432/pactora?schema=public"
# Generate a strong random secret with Node crypto; sessions are now enabled in the API.
SESSION_SECRET="replace-with-a-long-random-secret-before-use"
# Set true only after a production authentication and database setup is completed.
DEMO_MODE="true"

# Owner bootstrap values: set in your local shell, not in this file.
# OWNER_EMAIL=you@example.com
# OWNER_PASSWORD=use-a-long-unique-password-of-at-least-12-characters
# OWNER_DISPLAY_NAME=Workspace Owner
